# ------------------------------------------------------------------
# CANTON DYDX TRADING BOT - CONFIGURATION
# ------------------------------------------------------------------

# 1. NETWORK SETTINGS
# Options: 'mainnet' or 'testnet'
DYDX_NETWORK=mainnet

# 2. WALLET CREDENTIALS (REQUIRED)
# Your 12-24 word seed phrase from your dYdX wallet (e.g. Keplr/Metamask export)
# Ensure this wallet has funds on dYdX v4 chain (USDC).
DYDX_MNEMONIC=replace with your twelve word mnemonic phrase here

# Alternative: Private Key (Not recommended if Mnemonic is available)
# DYDX_PRIVATE_KEY=0x...

# 3. DATABASE CONNECTION
# MongoDB Connection String (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/canton-dydx

# 4. API SETTINGS (Optional)
# Port for the Next.js Dashboard (Default: 3000 or 3001)
PORT=3001
