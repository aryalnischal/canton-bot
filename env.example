# ------------------------------------------------------------------
# CANTON HYPERLIQUID TRADING BOT - CONFIGURATION
# ------------------------------------------------------------------

# 1. NETWORK SETTINGS
# Set to 'true' to trade on Hyperliquid testnet, 'false' for mainnet.
HL_TESTNET=true

# 2. WALLET CREDENTIALS (REQUIRED)
# Raw EVM private key (hex, with or without 0x prefix). This is the signer —
# it can be your main wallet's key, or a separate approved "agent wallet" key
# if you use HL_ACCOUNT_ADDRESS below to trade on behalf of another account.
HL_PRIVATE_KEY=replace with your hex private key here

# Optional: the account that actually holds funds/positions, if different
# from the signer above (agent-wallet pattern). Defaults to the signer's own address.
# HL_ACCOUNT_ADDRESS=0x...

# 3. DATABASE CONNECTION
# MongoDB Connection String (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/canton-dydx

# 4. API SETTINGS (Optional)
# Port for the Next.js Dashboard (Default: 3000 or 3001)
PORT=3001
