# LIVE TRADING SECRETS
# WARNING: NEVER COMMIT THIS FILE WITH REAL KEYS.
# RENAME TO .env.local

# 1. Hyperliquid (Arbitrum)
# The Private Key of your "API Wallet" (Secondary Account recommended)
# Format: 0x...
HL_PRIVATE_KEY=
# Your Wallet Address (for internal tracking)
HL_WALLET_ADDRESS=

# 2. Gate.io (Canton Coin)
# Create at https://www.gate.io/myaccount/apikeys
GATE_API_KEY=
GATE_API_SECRET=

# 3. Safety Settings
# Max size per trade in USD (Hard limit)
MAX_POSITION_SIZE_USD=100
# Global Kill Switch (TRUE to disable all execution)
KILL_SWITCH=FALSE
