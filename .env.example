# Canton Trading Bot — Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ── dYdX v4 ──
DYDX_NETWORK=mainnet                    # mainnet or testnet
DYDX_MNEMONIC=your_24_word_mnemonic_here   # Your dYdX wallet mnemonic

# ── MongoDB (Optional — bot works without it) ──
# Free tier: https://www.mongodb.com/cloud/atlas
# Local:     mongodb://localhost:27017/canton-bot
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/canton-bot?retryWrites=true&w=majority
